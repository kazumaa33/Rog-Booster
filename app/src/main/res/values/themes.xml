<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.RogBooster" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/rog_cyan</item>
        <item name="colorOnPrimary">@color/rog_bg</item>
        <item name="colorSecondary">@color/rog_red</item>
        <item name="android:colorBackground">@color/rog_bg</item>
        <item name="colorSurface">@color/rog_card</item>
        <item name="colorOnSurface">@color/rog_text</item>
        <item name="android:statusBarColor">@color/rog_bg</item>
        <item name="android:navigationBarColor">@color/rog_bg</item>
        <item name="android:windowBackground">@color/rog_bg</item>
    </style>
    <style name="RogCard">
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:padding">16dp</item>
        <item name="android:layout_marginBottom">12dp</item>
    </style>
    <style name="RogSectionTitle">
        <item name="android:textColor">@color/rog_cyan</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:layout_marginBottom">10dp</item>
    </style>
</resources>
